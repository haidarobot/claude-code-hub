# Claude Code Hub: copy to .env and adjust. Every value is optional.

# Where to listen. Keep 127.0.0.1 unless you set a login below.
HOST=127.0.0.1
PORT=3010

# --- Login (pick one) ---
# Built-in login page. Use a long random password.
#AUTH_PASSWORD=change-me-to-something-long
# Or: a reverse proxy in front already authenticates users (Caddy forward_auth, Authelia, Cloudflare Access…)
#AUTH_MODE=proxy

# Extra folders in the folder picker (Home is always included): Name=/path,Name=/path
#PLACES=Projects=/srv/projects,Websites=/var/www

# Optional web terminal tab (for example ttyd). {proto} and {host} are filled in from the browser address.
#TERMINAL_URL={proto}//{host}:7681/

# Name shown in the sidebar (defaults to the Linux user name)
#DISPLAY_NAME=

# Claude Code binary. Defaults to ~/.local/bin/claude, or the CLI bundled with the Agent SDK.
#CLAUDE_BIN=/home/me/.local/bin/claude

# Close an idle session's Claude process after this many minutes (history is kept; sending a message resumes it)
#IDLE_CLOSE_MIN=30

# Where pins, preferences and the cookie secret are stored
#STATE_DIR=/home/me/.claude-hub

# --- Notifications when Claude needs permission or finishes while no one is watching ---
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#NTFY_URL=https://ntfy.sh/your-secret-topic
# Any command; the message is passed as the last argument
#NOTIFY_COMMAND=/usr/local/bin/my-notifier
