# systemd service for Claude Code Hub.
# 1. Replace YOUR_USER with the Linux user that is logged in to Claude Code.
# 2. Replace /opt/claude-code-hub with the folder you cloned into, and /usr/bin/node with `which node`.
# 3. Put your settings in /opt/claude-code-hub/.env (see .env.example).
#
#   sudo cp examples/claude-code-hub.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now claude-code-hub
#   journalctl -u claude-code-hub -f

[Unit]
Description=Claude Code Hub (web UI for Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/opt/claude-code-hub
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
KillMode=mixed
TimeoutStopSec=15
# Claude Code and your tools must be on PATH
Environment=PATH=/home/YOUR_USER/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
